# Copy to .env.local. For local development, `pnpm db:start` prints these values
# (API_URL, PUBLISHABLE_KEY, SECRET_KEY, MAILPIT_URL).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used only by the end-to-end tests (setting up test users and reading sign-in
# codes from the local test inbox). Never set these in Vercel.
SUPABASE_SECRET_KEY=
MAILPIT_URL=http://127.0.0.1:54324
